<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <!-- S8: CUDA runtime for GPU layer offload. Its build props auto-copy the cuda12 native
         DLLs to runtimes/win-x64/native/cuda12/; selection between CPU and CUDA happens at
         runtime via LLamaSharp's NativeLibraryConfig (see InferenceEngine / HardwareDetector).
         Note: the CUDA builds require the matching CUDA toolkit to be installed on the
         machine; without it, the Vulkan backend below is the usable GPU path. -->
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.30.0" />
    <!-- S8: Vulkan runtime for GPU layer offload (works with the GPU driver alone, no CUDA
         toolkit needed). Auto-copies to runtimes/win-x64/native/vulkan/. -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.30.0" />
    <!-- DiffPlex: pure-managed diff engine behind DiffRenderer (S7 result editor). -->
    <PackageReference Include="DiffPlex" Version="1.1.0" />
  </ItemGroup>

  <!-- LLamaSharp.Backend.Cpu ships native DLLs under a non-standard folder
       (LLamaSharpRuntimes/...) with no auto-copy targets, so copy them explicitly.
       from the NuGet package cache ($(NuGetPackageRoot)) so the same paths work on
       any machine, including CI runners. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)\llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\win-x64\native\avx2\llama.dll" Link="llama.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)\llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\win-x64\native\avx2\ggml.dll" Link="ggml.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)\llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\win-x64\native\avx2\ggml-base.dll" Link="ggml-base.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)\llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\win-x64\native\avx2\ggml-cpu.dll" Link="ggml-cpu.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)\llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\win-x64\native\avx2\mtmd.dll" Link="mtmd.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Single-file publish: the LLamaSharp backend packages (Cpu, Cuda12 -> Cuda12.Linux)
       ship native assets for every RID and their build props copy ALL of them into the
       output as Content items (linked under runtimes/). Bundle only the win-x64 set so
       the portable exe stays small — drop the linux/osx/android assets. -->
  <ItemGroup>
    <Content Remove="$(NuGetPackageRoot)llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\linux*\**" />
    <Content Remove="$(NuGetPackageRoot)llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\osx*\**" />
    <Content Remove="$(NuGetPackageRoot)llamasharp.backend.cpu\0.30.0\LLamaSharpRuntimes\android*\**" />
    <Content Remove="$(NuGetPackageRoot)llamasharp.backend.cuda12.linux\0.30.0\LLamaSharpRuntimes\linux*\**" />
    <Content Remove="$(NuGetPackageRoot)llamasharp.backend.cuda12.linux\0.30.0\LLamaSharpRuntimes\osx*\**" />
  </ItemGroup>

</Project>
