<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Pinned llama.cpp build (S21): the exact tree Forge's FFI layer was verified
       against. Override LlamaRuntimeDir to point at a different build; the copy
       targets below are no-ops when the directory is absent, so CI without the
       local build still compiles (the app then fails at runtime with a clear
       message from LlamaNative.ResolveRuntimeDir). -->
  <PropertyGroup>
    <LlamaRuntimeDir Condition="'$(LlamaRuntimeDir)' == ''">C:\Users\uitaek\.unsloth\llama.cpp\build\bin\Release</LlamaRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- DiffPlex: pure-managed diff engine behind DiffRenderer (S7 result editor). -->
    <PackageReference Include="DiffPlex" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Cli" />
    <InternalsVisibleTo Include="Forge.App" />
  </ItemGroup>

  <!-- Native runtime DLLs from the pinned llama.cpp build, copied next to the
       executable so LlamaNative's DllImport resolves them (portable zip bundles
       the same set; see S21). The architecture-specific ggml-cpu-*.dll backends
       are all copied: ggml_backend_load_all picks the best one for the host CPU. -->
  <ItemGroup>
    <None Include="$(LlamaRuntimeDir)\llama.dll" Link="llama.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlamaRuntimeDir)\llama.dll')" />
    <None Include="$(LlamaRuntimeDir)\ggml.dll" Link="ggml.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlamaRuntimeDir)\ggml.dll')" />
    <None Include="$(LlamaRuntimeDir)\ggml-base.dll" Link="ggml-base.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlamaRuntimeDir)\ggml-base.dll')" />
    <None Include="$(LlamaRuntimeDir)\ggml-cpu-*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(LlamaRuntimeDir)\ggml-cuda.dll" Link="ggml-cuda.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlamaRuntimeDir)\ggml-cuda.dll')" />
    <None Include="$(LlamaRuntimeDir)\ggml-vulkan.dll" Link="ggml-vulkan.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(LlamaRuntimeDir)\ggml-vulkan.dll')" />
  </ItemGroup>

</Project>
