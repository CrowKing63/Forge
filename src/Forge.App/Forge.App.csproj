<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\Forge.App.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Native llama/ggml DLLs are copied from Forge.Core (which pins the LLamaSharp
       Backend.Cpu runtime path) and flow through this ProjectReference. -->
  <ItemGroup>
    <ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to the exe; loaded from disk (pack-URI resource lookup is
         case-sensitive and flaky on Windows). -->
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The "clang" strike, played on a successful replace (the forge's hammer hitting the anvil). -->
    <Content Include="Assets\clang.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
