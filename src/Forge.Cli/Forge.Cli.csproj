<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Native llama/ggml DLLs are copied from Forge.Core (which pins the LLamaSharp
       Backend.Cpu runtime path) and flow through this ProjectReference. -->
  <ItemGroup>
    <ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
  </ItemGroup>

  <!-- S13: the Korean eval set ships next to the exe so `eval` finds it at runtime. -->
  <ItemGroup>
    <Content Include="eval-set.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
